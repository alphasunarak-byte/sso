# ==============================================================================
# OAuth 2.0 Client & IdP Configuration (ระบบยืนยันตัวตนกลาง รพ.หนองหาน [11018])
# ==============================================================================

# 1. ข้อมูล Client สำหรับเชื่อมต่อกับ Identity Provider (IdP)
OAUTH_CLIENT_ID="super-app-nhh-11018"
OAUTH_CLIENT_SECRET="your_oauth_client_secret_here"

# 2. Redirect URI ของ Client Application ที่ลงทะเบียนไว้กับ IdP
OAUTH_REDIRECT_URI="http://localhost:3030/api/auth/callback"

# 3. OAuth 2.0 / OIDC Endpoints ของ Identity Provider (IdP)
OAUTH_AUTH_URL="http://localhost:3030/oauth/authorize"
OAUTH_TOKEN_URL="http://localhost:3030/api/oauth/token"
OAUTH_USERINFO_URL="http://localhost:3030/api/oauth/userinfo"

# 4. Scope ที่ต้องการขอสิทธิ์เข้าถึงข้อมูล
OAUTH_SCOPE="openid profile provider hospital.11018"

# 5. คีย์สำหรับเข้ารหัส Session JWT (เปลี่ยนเป็นสตริงสุ่มความยาวอย่างน้อย 32 ตัวอักษร)
JWT_SECRET="generate_a_secure_random_jwt_secret_key_at_least_32_characters"
NHH_IDP_SECRET="generate_a_secure_random_idp_secret_key_at_least_32_characters"

# ==============================================================================
# Hospital & MOPH Gateway Credentials (โรงพยาบาลหนองหาน)
# ==============================================================================
PORT=3030
HOSPITAL_CODE="11018"
HOSPITAL_NAME="โรงพยาบาลหนองหาน"
SERVICE_NAME="Super App By รพ.หนองหาน"
APP_ENV="PRD"

# MOPH Health ID (ส่วนที่ 1)
MOPH_CLIENT_ID_UAT="your_moph_client_id_uat"
MOPH_CLIENT_SECRET_UAT="your_moph_client_secret_uat"
MOPH_CLIENT_ID_PRD="your_moph_client_id_prd"
MOPH_CLIENT_SECRET_PRD="your_moph_client_secret_prd"

# Provider ID (ส่วนที่ 2)
PROVIDER_CLIENT_ID_UAT="your_provider_client_id_uat"
PROVIDER_SECRET_KEY_UAT="your_provider_secret_key_uat"
PROVIDER_CLIENT_ID_PRD="your_provider_client_id_prd"
PROVIDER_SECRET_KEY_PRD="your_provider_secret_key_prd"

# System Administrator CIDs (คั่นด้วยจุลภาค)
ADMIN_CIDS="1439900002681"
ADMIN_HASH_CIDS="fb76972749bff90cca10057a798a54acc84d8512bc3d77e3e9589b61fcc5728d"
